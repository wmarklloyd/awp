{
  "description": "Start or attach the AWP doorbell when a Codex session enters this project.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/awp_codex_session_start.py\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& python (Join-Path (git rev-parse --show-toplevel) 'tools\\awp_codex_session_start.py')\"",
            "async": true,
            "timeout": 30,
            "statusMessage": "Starting AWP doorbell"
          }
        ]
      }
    ]
  }
}
